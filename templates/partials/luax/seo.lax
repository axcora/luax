<meta name="google-site-verification" content="fJTzwsNcz2AtRxQpJZzU7db7TLPdR_lKSAXfyWDtHB4">
<meta name="google-site-verification" content="Xi3WpckDbMBvm1pdlc5XukNoA9uWDmnExIiOeaTOxq0">

@if title
<title>@title</title>
@else
<title>@luax.title</title>
@end

@if description
<meta name="description" content="@description">
@else
<meta name="description" content="@luax.description">
@end

@if og_type
<meta property="og:type" content="@og_type">
@else
<meta property="og:type" content="website">
@end

@if og_title
<meta property="og:title" content="@og_title">
@else
  @if title
  <meta property="og:title" content="@title">
  @else
  <meta property="og:title" content="@luax.title">
  @end
@end

@if og_description
<meta property="og:description" content="@og_description">
@else
  @if description
  <meta property="og:description" content="@description">
  @else
  <meta property="og:description" content="@luax.description">
  @end
@end

@if og_image
<meta property="og:image" content="@luax.url@og_image">
@else
  @if image
  <meta property="og:image" content="@luax.url@image">
  @else
  <meta property="og:image" content="@luax.url@luax.image">
  @end
@end

<meta property="og:url" content="@luax.url@current_url">
<meta property="og:site_name" content="@luax.title">
<meta name="twitter:card" content="summary_large_image">

@if og_title
<meta name="twitter:title" content="@og_title">
@else
  @if title
  <meta name="twitter:title" content="@title">
  @else
  <meta name="twitter:title" content="@luax.title">
  @end
@end

@if og_description
<meta name="twitter:description" content="@og_description">
@else
  @if description
  <meta name="twitter:description" content="@description">
  @else
  <meta name="twitter:description" content="@luax.description">
  @end
@end

@if og_image
<meta name="twitter:image" content="@luax.url@og_image">
@else
  @if image
  <meta name="twitter:image" content="@luax.url@image">
  @else
  <meta name="twitter:image" content="@luax.url@luax.image">
  @end
@end

<meta name="generator" content="LUAX v1.2 - LUA Static Site Generator by Axcora">

@if metadata.twitter_user
<meta name="twitter:site" content="@luax.twitter_user">
@end

@if metadata.favicon
<link rel="icon" href="@luax.url@luax.favicon">
@end

<link rel="canonical" href="@luax.url@current_url">

<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "@@json_ld_type",
  "headline": "@title",
  "description": "@description",
  "url": "@luax.url@current_url",
  "datePublished": "@date",
  "dateModified": "@date",
  "image": "@luax.url@og_image",
  "author": {
    "@@type": "Person",
    "name": "@author"
  }
}
</script>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=JetBrains+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/axcora-css@1.0.1/axcora.min.css">