<section class="showcase">
  <img src="@luax.showcase.image" 
  class="showcase-bg" alt="@luax.title">
  <div class="showcase-content">
    <span class="section-label">@luax.showcase.info</span>
    <h2 class="section-title">@luax.showcase.title1<br><em>@luax.showcase.title2</em></h2>
    <p class="section-p" style="margin:18px auto 0">
      @luax.showcase.text
    </p>
    <div class="p-3 mt-3">
      <a href="@luax.showcase.button.url" class="btn-luax me-2 mt-1 mb-1">@luax.showcase.button.text</a>
      <a href="@luax.showcase.button_ghost.url" class="btn-ghost mt-1 mb-1">@luax.showcase.button_ghost.text ↓</a>
    </div>
  </div>
</section>