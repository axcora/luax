<section>
<div class="row">
<div class="col-md-12 p-3 p-md-5 ">
        <h2 class="text-center fw-bold">@metadata.starter.title</h2>
        </div>

        <article class="row">
            
                <div class="col-md-6 p-3">
                <div class="p-3 shadow-sm rounded-5 bg-light">
                    <a href="@metadata.starter.version1.url" title="@metadata.starter.version1.title">
                        <img class="img-fluid rounded-5"
                            alt="@metadata.starter.version1.title" 
                            width="100%" 
                            height="100%"
                            src="@metadata.starter.version1.image" />
                    </a>   
                    <div class="p-2 text-center">
                        <h3 class="h5">
                            <a href="@metadata.starter.version1.url">@metadata.starter.version1.title</a>
                        </h3>                        
                    </div>
                    </div>
                </div>

                
                <div class="col-md-6 p-3">
                <div class="p-3 shadow-sm rounded-5 bg-light">
                    <a href="@metadata.starter.version2.url" title="@metadata.starter.version2.title">
                        <img class="img-fluid rounded-5"
                            alt="@metadata.starter.version2.title" 
                            width="100%" 
                            height="100%"
                            src="@metadata.starter.version2.image" />
                    </a>   
                    <div class="p-2 text-center">
                        <h3 class="h5">
                            <a href="@metadata.starter.version2.url">@metadata.starter.version2.title</a>
                        </h3>                        
                    </div>
                    </div>
                </div>
            
        </article>                   
</section>