<section class="hero-section py-5 mt-3">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1 class="display-4 mb-3"><a href="@metadata.url" class="fw-bold">
                @metadata.home.title
                </a></h1>
                <h2 class="lead mb-4">@metadata.home.description</h2>
                <p class="small">@metadata.home.intro</p>
                <div class="d-flex gap-3 flex-wrap">
                    <a href="@metadata.home.button1.url" class="btn btn-primary btn-lg">@metadata.home.button1.text</a>
                    <a href="@metadata.home.button2.url" class="btn btn-outline-secondary btn-lg">@metadata.home.button2.text</a>
                </div>
            </div>
            <div class="col-md-6 mt-4 mt-md-0">
                <div class="terminal-window">
                    <div class="terminal-header">
                        <span class="terminal-dot red"></span>
                        <span class="terminal-dot yellow"></span>
                        <span class="terminal-dot green"></span>
                        <span class="terminal-title">Terminal</span>
                    </div>
                    <div class="terminal-body">
                        <div class="terminal-line">
                            <span class="terminal-prompt">$</span>
                            <span class="terminal-command small">git clone https://github.com/mesinkasir/luax.git</span>
                        </div>
                        <div class="terminal-line">
                            <span class="terminal-prompt">$</span>
                            <span class="terminal-command">luax build</span>
                        </div>
                        <div class="terminal-line">
                            <span class="terminal-output">✨ Build complete! 7 posts generated</span>
                        </div>
                        <div class="terminal-line">
                            <span class="terminal-prompt">$</span>
                            <span class="terminal-command">luax start</span>
                        </div>
                        <div class="terminal-line">
                            <span class="terminal-output">✓ Server started at port 8080</span>
                        </div>
                        <div class="terminal-line">
                            <span class="terminal-output">🌐 http://localhost:8080</span>
                        </div>
                    </div>
                </div>
            </div>            
        </div>
    </div>
</section>
